{% extends 'base.html.twig' %}

{% block title %}Over ons — Café Java{% endblock %}

{% block body %}
    <section class="page-hero">
        <div class="container">
            <h1>Over Café Java</h1>
            <p>Een warme koffiebar in het hart van de stad, waar koffie, werk en gezelligheid samenkomen.</p>
        </div>
    </section>

    <section class="section">
        <div class="container about-grid">
            <div>
                <h2>Ons verhaal</h2>
                <p>
                    Café Java werd in 2014 geopend met één simpel idee: een plek maken waar
                    goede koffie en een rustige werkplek elkaar ontmoeten. Wat begon als een
                    klein hoekpand is uitgegroeid tot de favoriete stek van studenten,
                    freelancers en buurtbewoners die er graag een middag neerstrijken.
                </p>
                <p>
                    Onze bonen worden wekelijks vers gebrand door een lokale koffiebrander.
                    Elke kop wordt met zorg gezet door ons team van gepassioneerde barista's,
                    die je graag meer vertellen over herkomst en smaakprofielen.
                </p>

                <h2>Waarom klanten blijven terugkomen</h2>
                <ul class="highlight-list">
                    <li>
                        <span class="icon">☕</span>
                        <span><strong>Ambachtelijke koffie</strong> — van romige flat white tot pittige espresso, altijd vers gezet.</span>
                    </li>
                    <li>
                        <span class="icon">💻</span>
                        <span><strong>Werkvriendelijk</strong> — snelle wifi, veel stopcontacten en rustige hoekjes om je te focussen.</span>
                    </li>
                    <li>
                        <span class="icon">🥐</span>
                        <span><strong>Vers gebak</strong> — dagelijks gebakken taarten, broodjes en koekjes bij je koffie.</span>
                    </li>
                    <li>
                        <span class="icon">🌱</span>
                        <span><strong>Duurzaam ingekocht</strong> — fair-trade bonen en lokale leveranciers waar mogelijk.</span>
                    </li>
                    <li>
                        <span class="icon">🐾</span>
                        <span><strong>Huisdiervriendelijk terras</strong> — neem gerust je hond mee naar ons buitenterras.</span>
                    </li>
                </ul>
            </div>

            <div>
                <table class="hours-table">
                    <caption>Openingstijden</caption>
                    <tbody>
                        <tr><th>Maandag</th><td>08:00 – 18:00</td></tr>
                        <tr><th>Dinsdag</th><td>08:00 – 18:00</td></tr>
                        <tr><th>Woensdag</th><td>08:00 – 18:00</td></tr>
                        <tr><th>Donderdag</th><td>08:00 – 20:00</td></tr>
                        <tr><th>Vrijdag</th><td>08:00 – 20:00</td></tr>
                        <tr><th>Zaterdag</th><td>09:00 – 20:00</td></tr>
                        <tr><th>Zondag</th><td>09:00 – 17:00</td></tr>
                    </tbody>
                </table>

                <div class="info-card" style="margin-top: 24px;">
                    <h3>Goed om te weten</h3>
                    <p>Op donderdagavond hebben we live acoustic muziek vanaf 19:00 uur.
                    Op de eerste zaterdag van de maand organiseren we een gratis koffie-proeverij.</p>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
